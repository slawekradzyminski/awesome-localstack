[Unit]
Description=Encrypted PostgreSQL backup for Awesome Testing
Requires=docker.service
After=docker.service
# The watchdog role installs the notifier; it sends the unit's result and last
# log lines to the Alertmanager Telegram chat.
OnFailure=awesome-watchdog-notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --nonblock /run/awesome-postgres-backup.lock /usr/local/sbin/awesome-postgres-backup scheduled
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=30min
