# Copy this file to `ansible/inventory/group_vars/production/vault.yml`
# and encrypt it with:
#
#   cd ansible
#   ansible-vault encrypt inventory/group_vars/production/vault.yml --vault-password-file .vault_pass
#
# The encrypted `vault.yml` stays local and must not be committed.

production_ssh_host: example.host
production_ssh_port: "22"
production_ssh_user: root
production_ssh_key_path: /absolute/path/to/private-key
# Telegram bot and chat shared by Alertmanager and the host watchdog.
alertmanager_telegram_bot_token: replace-with-the-botfather-token
alertmanager_telegram_chat_id: "123456789"
# Optional dead-man ping for the host watchdog, for example a Healthchecks.io
# check URL (https://hc-ping.com/<uuid>). Empty disables the ping.
watchdog_healthcheck_url: ""
artemis_username: awesome-broker
artemis_password: replace-with-a-strong-broker-secret
# Used by both the PostgreSQL container and the backend datasource. The
# deployment reconciles an existing postgres role before recreating services.
postgres_password: replace-with-a-strong-database-secret
app_bootstrap_admin_enabled: "true"
app_bootstrap_admin_username: admin
app_bootstrap_admin_password: replace-with-a-16-plus-character-secret
app_bootstrap_admin_email: awesome@testing.com
app_bootstrap_admin_first_name: Slawomir
app_bootstrap_admin_last_name: Radzyminski
app_mfa_encryption_password: replace-with-at-least-32-random-characters
app_mfa_encryption_salt: replace-with-at-least-16-random-bytes-in-hex
# RS256 access-token signing keys: single-line base64 PKCS#8 RSA keys of at
# least 2048 bits, different for each backend. Generate with
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 | tr -d '\n'
# Rotating a key invalidates existing access tokens (clients refresh them).
jwt_signing_key: replace-with-base64-pkcs8-rsa-private-key
aitesters_jwt_signing_key: replace-with-a-different-base64-pkcs8-rsa-private-key
# Passwords of the `warehouse` database roles (schema warehouse only).
warehouse_postgres_password: replace-with-at-least-16-random-characters
aitesters_warehouse_postgres_password: replace-with-a-different-value-of-at-least-16-characters
# Shared by the backend internal API and warehouse-service (X-Service-Token).
# Generate with `openssl rand -hex 32`.
warehouse_service_token: replace-with-at-least-32-random-bytes
# The aitesters sandbox: its own warehouse service token and aitesters-postgres password.
aitesters_warehouse_service_token: replace-with-a-different-random-value-of-at-least-32-bytes
aitesters_postgres_password: replace-with-at-least-16-random-characters
# Passwords of the `payment` database roles (schema payment only), distinct from
# every other database password.
payment_postgres_password: replace-with-a-third-value-of-at-least-16-characters
aitesters_payment_postgres_password: replace-with-a-fourth-value-of-at-least-16-characters
# Shared by the backend and payment-service (X-Service-Token both ways). Generate
# each with `openssl rand -hex 32`; every token must differ from the others.
payment_service_token: replace-with-at-least-32-random-bytes
aitesters_payment_service_token: replace-with-a-different-random-value-of-at-least-32-bytes
# HMAC-SHA256 key of the X-Payment-Signature header on payment result
# notifications (payment-service -> backend). `openssl rand -hex 32`, distinct
# per site and from the service tokens.
payment_webhook_secret: replace-with-at-least-32-random-bytes
aitesters_payment_webhook_secret: replace-with-a-different-random-value-of-at-least-32-bytes
# notification-service (one per site). Its X-Service-Token for the backend's
# event feed, JWKS and webhook export: `openssl rand -hex 32`, distinct from every
# other token and secret.
notification_service_token: replace-with-at-least-32-random-bytes
aitesters_notification_service_token: replace-with-a-different-random-value-of-at-least-32-bytes
# Passwords of the `notification` database roles (schema notification only),
# distinct from every other database password.
notification_postgres_password: replace-with-a-fifth-value-of-at-least-16-characters
aitesters_notification_postgres_password: replace-with-a-sixth-value-of-at-least-16-characters
# Key that encrypts the webhook signing secrets notification-service stores
# (WEBHOOKS_SECRET_ENCRYPTION_PASSWORD / _SALT). Password: at least 32 random
# characters; salt: at least 16 random bytes in hex (`openssl rand -hex 16`).
# Changing them makes stored secrets unreadable, so keep them stable.
notification_webhook_secret_encryption_password: replace-with-at-least-32-random-characters
notification_webhook_secret_encryption_salt: replace-with-at-least-16-random-bytes-in-hex
aitesters_notification_webhook_secret_encryption_password: replace-with-a-different-value-of-at-least-32-characters
aitesters_notification_webhook_secret_encryption_salt: replace-with-at-least-16-random-bytes-in-hex

# Required when postgres_backup_enabled is true. Keep a separate offline copy:
# losing this passphrase makes encrypted backups unrecoverable.
backup_encryption_passphrase: replace-with-at-least-32-random-characters

# Optional rsync destination for encrypted archives. The destination is expected
# to exist and SSH host-key/authentication setup must already be configured.
# Example: backup@example.net:/srv/backups/awesome-testing
backup_remote_target: ""
# Grants trusted E2E automation access to the protected aitesters email outbox.
local_email_outbox_access_key: replace-with-at-least-32-random-bytes
